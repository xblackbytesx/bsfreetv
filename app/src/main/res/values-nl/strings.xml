    <string name="dh_intro">De Shield heeft geen keuzemenu voor de startscherm-app. BSfreeTV wordt het startscherm door via adb de standaard launcher uit te schakelen. Dat kan BSfreeTV zelf, zodra Netwerkfoutopsporing aan staat.</string>
    <string name="status_home_ours">Thuisknop opent BSfreeTV</string>
    <string name="status_home_stock">Thuisknop opent de standaard launcher</string>
    <string name="status_home_other">Thuisknop opent %1$s</string>
    <string name="status_home_chooser">Thuisknop opent een keuzemenu</string>
    <string name="status_pkg_enabled">%1$s: ingeschakeld</string>
    <string name="status_pkg_disabled">%1$s: uitgeschakeld</string>
    <string name="dh_steps">1. Instellingen > Apparaatvoorkeuren > Over > tik 7 keer op Build.\n2. Ontwikkelaarsopties > zet Netwerkfoutopsporing aan.\n3. Ga terug, druk op BSfreeTV als startscherm en kies Toestaan (vink Altijd toestaan aan) in de melding.</string>
    <string name="btn_make_home">BSfreeTV als startscherm</string>
    <string name="btn_test">Verbinding testen</string>
    <string name="btn_restore">Standaard herstellen</string>
    <string name="dh_turn_off">Zet Netwerkfoutopsporing daarna weer uit: anders kan iedereen op je netwerk vragen om verbinding.</string>
    <string name="dh_uninstall_warning">Herstel de standaard launcher voordat je BSfreeTV verwijdert, anders opent de thuisknop niets.</string>

