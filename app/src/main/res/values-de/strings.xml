    <string name="dh_intro">Die Shield hat keine Auswahl für die Startbildschirm-App. BSfreeTV wird zum Startbildschirm, indem der Standard-Launcher über adb deaktiviert wird. Das erledigt BSfreeTV selbst, sobald Netzwerk-Debugging aktiviert ist.</string>
    <string name="status_home_ours">Home-Taste öffnet BSfreeTV</string>
    <string name="status_home_stock">Home-Taste öffnet den Standard-Launcher</string>
    <string name="status_home_other">Home-Taste öffnet %1$s</string>
    <string name="status_home_chooser">Home-Taste öffnet eine Auswahl</string>
    <string name="status_pkg_enabled">%1$s: aktiviert</string>
    <string name="status_pkg_disabled">%1$s: deaktiviert</string>
    <string name="status_next_up_granted">Zugriff für Weiterschauen erteilt</string>
    <string name="status_next_up_missing">Kein Zugriff für Weiterschauen</string>
    <string name="status_debug_on">Debugging ist aktiviert</string>
    <string name="status_debug_off">Debugging ist deaktiviert (Entwickleroptionen)</string>
    <string name="dh_steps">1. Einstellungen > Geräteeinstellungen > Info > 7-mal auf Build tippen.\n2. Entwickleroptionen > Netzwerk-Debugging aktivieren.\n3. Unten eine Schaltfläche drücken und in der Meldung Zulassen wählen (Immer zulassen ankreuzen).</string>
