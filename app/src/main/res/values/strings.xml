    <!-- Default launcher page -->
    <string name="dh_intro">The Shield has no Home picker. BSfreeTV becomes Home by disabling the stock launcher through adb, which it can do itself once Network debugging is on.</string>
    <string name="status_home_ours">Home button opens BSfreeTV</string>
    <string name="status_home_stock">Home button opens the stock launcher</string>
    <string name="status_home_other">Home button opens %1$s</string>
    <string name="status_home_chooser">Home button opens a chooser</string>
    <!-- %1$s is a package name such as "tvlauncher". -->
    <string name="status_pkg_enabled">%1$s: enabled</string>
    <string name="status_pkg_disabled">%1$s: disabled</string>
    <string name="dh_steps">1. Settings > Device Preferences > About > tap Build 7 times.\n2. Developer options > turn on Network debugging.\n3. Go back, press Make BSfreeTV Home and choose Allow (tick Always allow) on the prompt.</string>
    <string name="btn_make_home">Make BSfreeTV Home</string>
    <string name="btn_test">Test connection</string>
    <string name="btn_restore">Restore stock</string>
    <string name="dh_turn_off">Then turn Network debugging off again: anyone on your network could otherwise ask to connect.</string>
    <string name="dh_uninstall_warning">Restore the stock launcher before uninstalling BSfreeTV, or the Home button has nothing to open.</string>

