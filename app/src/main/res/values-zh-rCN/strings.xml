    <string name="dh_intro">Shield 没有选择主屏幕应用的选项。BSfreeTV 通过 adb 停用系统自带的启动器来成为主屏幕。开启网络调试后，BSfreeTV 可以自己完成这一步。</string>
    <string name="status_home_ours">主屏幕键打开 BSfreeTV</string>
    <string name="status_home_stock">主屏幕键打开系统自带启动器</string>
    <string name="status_home_other">主屏幕键打开 %1$s</string>
    <string name="status_home_chooser">主屏幕键打开选择器</string>
    <string name="status_pkg_enabled">%1$s：已启用</string>
    <string name="status_pkg_disabled">%1$s：已停用</string>
    <string name="dh_steps">1. 设置 > 设备偏好设置 > 关于 > 点按“版本号”7 次。\n2. 开发者选项 > 开启“网络调试”。\n3. 返回并按“将 BSfreeTV 设为主屏幕”，在弹出的提示中选择“允许”（勾选“始终允许”）。</string>
    <string name="btn_make_home">将 BSfreeTV 设为主屏幕</string>
