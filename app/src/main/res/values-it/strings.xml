    <string name="dh_intro">La Shield non permette di scegliere l\'app Home. BSfreeTV diventa la schermata Home disattivando il launcher originale tramite adb, cosa che può fare da solo appena attivi il debug di rete.</string>
    <string name="status_home_ours">Il tasto Home apre BSfreeTV</string>
    <string name="status_home_stock">Il tasto Home apre il launcher originale</string>
    <string name="status_home_other">Il tasto Home apre %1$s</string>
    <string name="status_home_chooser">Il tasto Home apre un menu di scelta</string>
    <string name="status_pkg_enabled">%1$s: attivo</string>
    <string name="status_pkg_disabled">%1$s: disattivato</string>
    <string name="dh_steps">1. Impostazioni > Preferenze dispositivo > Informazioni > premi 7 volte su Build.\n2. Opzioni sviluppatore > attiva Debug di rete.\n3. Torna indietro, premi BSfreeTV come Home e scegli Consenti (spunta Consenti sempre) nel messaggio.</string>
    <string name="btn_make_home">BSfreeTV come Home</string>
    <string name="btn_test">Prova la connessione</string>
    <string name="btn_restore">Ripristina l\'originale</string>
    <string name="dh_turn_off">Poi disattiva di nuovo il debug di rete: altrimenti chiunque sulla tua rete potrebbe chiedere di collegarsi.</string>
    <string name="dh_uninstall_warning">Ripristina il launcher originale prima di disinstallare BSfreeTV, altrimenti il tasto Home non aprirà nulla.</string>

